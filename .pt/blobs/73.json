{"content":"/* Wooden mallets and themed obstacle variants are exclusive to Hammer Battle. */\n(function(root){'use strict';const A=root.PixelBomberAssets,R=A.rect;\nfunction mallet(c,weapon='normal'){const big=weapon==='heavy',x=18,w=big?18:14,h=big?22:18;R(c,5,-2,22,4,'#67452e');R(c,6,-2,18,1,'#e2bf83');R(c,x+2,-h/2,w-4,h,'#65432d');R(c,x,-h/2+3,w,h-6,'#99623b');R(c,x+2,-h/2+1,w-4,h-2,'#bc8750');R(c,x+3,-h/2+2,w-6,3,'#e9c18a');R(c,x+w-4,-h/2+4,3,h-8,'#7f4e30');for(let yy=-h/2+7;yy<h/2-3;yy+=4)R(c,x+3,yy,w-8,1,'#9b663e');R(c,x+3,-2,4,3,'#d5a76c');if(weapon==='thunder'){c.strokeStyle='#89e7ec';c.lineWidth=1;c.strokeRect(x-2,-h/2-2,w+4,h+4);}if(weapon==='boomerang'){R(c,x+5,-4,3,8,'#bda1ed');R(c,x+3,-2,7,3,'#d5bcff');}}\nfunction obstacle(c,t,x,y,map,variant,time){const theme=root.PixelBomberCore.THEMES[map];A.tile(c,'.',x,y,theme,time);if(t==='S'&&(x===0||y===0||x===448||y===384)){A.tile(c,'S',x,y,theme,time);return;}R(c,x+3,y+24,27,7,'#192d354d');if(t==='B'){if(variant===0){A.tile(c,'B',x,y,theme,time);return;}if(variant===1){const color=map===1?'#c67155':map===2?'#7ea9bd':'#a47148';R(c,x+6,y+4,20,24,'#4e3832');R(c,x+4,y+8,24,16,color);R(c,x+6,y+5,20,22,color);R(c,x+7,y+3,18,4,'#ddbe895e');R(c,x+5,y+10,22,3,'#524b43');R(c,x+5,y+22,22,3,'#524b43');R(c,x+12,y+7,2,18,'#f1d6a13d');R(c,x+7,y+28,18,2,'#322f2f');if(map===1){R(c,x+12,y+14,8,7,'#f4cd71');R(c,x+15,y+15,2,5,'#8e5139');}}else{const color=map===2?'#a6cfda':'#ab8659';R(c,x+3,y+10,26,19,'#604937');R(c,x+4,y+11,24,16,color);R(c,x+6,y+5,20,7,color);R(c,x+9,y+3,14,3,'#d7c099');R(c,x+5,y+16,22,3,'#625645');R(c,x+14,y+13,5,9,'#eccb77');R(c,x+15,y+15,3,3,'#5b523e');if(map===2){R(c,x+5,y+9,9,5,'#e1f2ef');R(c,x+22,y+21,5,5,'#80b5c4');}}return;}\nif(map===0){if(variant===0){R(c,x+4,y+17,24,11,'#556c66');R(c,x+6,y+9,19,16,'#7e9481');R(c,x+10,y+5,12,6,'#a8b69b');R(c,x+7,y+11,4,3,'#ced3b1');R(c,x+21,y+16,5,9,'#475c55');}else if(variant===1){R(c,x+13,y+20,7,10,'#79563b');R(c,x+5,y+9,23,15,'#335e45');R(c,x+8,y+4,18,19,'#47774f