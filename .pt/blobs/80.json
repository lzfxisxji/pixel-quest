{"content":".mode-home-navigation{margin:0 0 20px;display:flex;justify-content:flex-start}.mode-home-navigation a{display:inline-flex;align-items:center;padding:11px 16px;background:#1f3039;border:1px solid #435963;border-bottom:3px solid #10202a;border-radius:5px;color:#e6c47f;text-decoration:none;font:12px monospace;letter-spacing:.3px}.mode-home-navigation a:hover{background:#2b404a;color:#ffda8b;border-color:#b39457}.mode-home-navigation a:focus-visible{outline:3px solid #f5b947;outline-offset:3px}.lobby-home .mode-home-navigation{display:none}@media(max-width:700px){.mode-home-navigation{margin-bottom:14px}.mode-home-navigation a{font-size:11px;padding:10px 13px}}\r\n","encoding":"utf-8"}